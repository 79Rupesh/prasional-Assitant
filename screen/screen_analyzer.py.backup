import json
import subprocess

from screen.screen_analyzer_provider import ScreenAnalyzerProvider


class ScreenAnalyzer(ScreenAnalyzerProvider):

    # Screenshot physical resolution
    SCREEN_WIDTH = 3420
    SCREEN_HEIGHT = 2224

    # Retina scaling: screenshot pixels -> mouse coordinates
    MOUSE_SCALE_X = 0.5
    MOUSE_SCALE_Y = 0.5

    def find_text(self, image_path: str, target: str) -> dict:
        result = self.analyze(image_path)

        if result["status"] != "success":
            return result

        target = target.lower().strip()

        exact_matches = []
        partial_matches = []

        for element in result["elements"]:
            text = element["text"].lower().strip()

            center_x = (
                element["pixel_x"]
                + element["pixel_width"] // 2
            )

            center_y = (
                element["pixel_y"]
                + element["pixel_height"] // 2
            )

            mouse_x = int(center_x * self.MOUSE_SCALE_X)
            mouse_y = int(center_y * self.MOUSE_SCALE_Y)

            candidate = {
                "status": "success",
                "text": element["text"],
                "screenshot_x": center_x,
                "screenshot_y": center_y,
                "x": mouse_x,
                "y": mouse_y
            }

            if text == target:
                exact_matches.append(candidate)

            elif target in text:
                partial_matches.append(candidate)

        # Prefer exact matches
        matches = exact_matches if exact_matches else partial_matches

        if not matches:
            return {
                "status": "not_found",
                "text": target
            }

        # If only one match exists, use it
        if len(matches) == 1:
            return matches[0]

        # Multiple matches:
        # Prefer elements that are lower on the screen.
        #
        # This helps when the same text appears in:
        # - search box / header
        # - actual search result
        #
        # Higher screenshot_y = lower on screen.
        matches.sort(
            key=lambda item: item["screenshot_y"],
            reverse=True
        )

        return matches[0]

    def analyze(self, image_path: str) -> dict:
        try:
            result = subprocess.run(
                ["./screen/vision_ocr", image_path],
                capture_output=True,
                text=True,
                check=True
            )

            observations = json.loads(result.stdout)

            for element in observations:
                # Vision normalized coordinates -> screenshot pixels
                element["pixel_x"] = int(
                    element["x"] * self.SCREEN_WIDTH
                )

                element["pixel_y"] = int(
                    (1 - element["y"] - element["height"])
                    * self.SCREEN_HEIGHT
                )

                element["pixel_width"] = int(
                    element["width"] * self.SCREEN_WIDTH
                )

                element["pixel_height"] = int(
                    element["height"] * self.SCREEN_HEIGHT
                )

            return {
                "status": "success",
                "elements": observations
            }

        except subprocess.CalledProcessError as error:
            return {
                "status": "error",
                "message": error.stderr
            }

        except json.JSONDecodeError:
            return {
                "status": "error",
                "message": "Invalid OCR output."
            }