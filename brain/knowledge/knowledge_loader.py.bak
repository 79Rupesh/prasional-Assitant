
from pathlib import Path


class KnowledgeLoader:
    """Loads Ela's master knowledge file."""

    def __init__(self, knowledge_path=None):
        project_root = Path(__file__).resolve().parents[2]

        self.knowledge_path = (
            Path(knowledge_path)
            if knowledge_path
            else project_root / "data" / "ela_knowledge.txt"
        )

        self._knowledge = None

    def load(self, force_reload=False):
        """Load knowledge once; optionally reload after edits."""
        if self._knowledge is not None and not force_reload:
            return self._knowledge

        if not self.knowledge_path.is_file():
            raise FileNotFoundError(
                f"Ela knowledge file not found: {self.knowledge_path}"
            )

        content = self.knowledge_path.read_text(encoding="utf-8").strip()

        if not content:
            raise ValueError(
                f"Ela knowledge file is empty: {self.knowledge_path}"
            )

        self._knowledge = content
        return self._knowledge

    def get_relevant_sections(self, query, max_chars=6000):
        """
        Basic section retrieval.
        Returns matching sections first, within a character limit.
        This is a simple first version, not semantic search.
        """
        content = self.load()
        query_words = {
            word.casefold().strip(".,?!:;()[]{}\"'")
            for word in query.split()
            if len(word.strip(".,?!:;()[]{}\"'")) > 2
        }

        sections = []
        current = []

        for line in content.splitlines():
            if line.startswith("## ") and current:
                sections.append("\n".join(current).strip())
                current = [line]
            else:
                current.append(line)

        if current:
            sections.append("\n".join(current).strip())

        scored = []
        for index, section in enumerate(sections):
            words = set(
                word.casefold().strip(".,?!:;()[]{}\"'")
                for word in section.split()
            )
            score = len(query_words & words)
            if score:
                scored.append((score, index, section))

        # Keep original section order among equally scored sections.
        scored.sort(key=lambda item: (-item[0], item[1]))

        selected = []
        used_chars = 0

        for _, _, section in scored:
            remaining = max_chars - used_chars
            if remaining <= 0:
                break

            piece = section[:remaining]
            selected.append(piece)
            used_chars += len(piece)

        if not selected:
            return content[:max_chars]

        return "\n\n".join(selected)
